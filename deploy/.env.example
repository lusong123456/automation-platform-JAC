# 环境变量样例：复制为 .env 后填写（.env 不入库）
# 注意：.env 统一 UTF-8 + LF 保存，变量值不要留尾随空格

# 被测合同审核测试环境根地址（必填）
#   假服务   → http://host.docker.internal:9000
#   甲方环境 → http://<被测环境IP>:<端口>
BASE_URL=

# 被测环境登录认证
# AUTH_MODE 固定为客户端凭证，平台页面不提供切换
AUTH_MODE=client_credentials

# —— 账号密码（页面只读展示，用于登录测试自动获取客户端凭证）——
TEST_USERNAME=
TEST_PASSWORD=

# —— 客户端凭证模式 ——
# employeeId 决定"以谁的身份执行"
APP_ID=
APP_SECRET=
APP_EMPLOYEE_ID=

# Token 生命周期（秒）：TTL 与提前续期阈值
TOKEN_TTL_SECONDS=1800
TOKEN_REFRESH_AHEAD=300

# 单个接口请求超时（秒），由用例侧读取
HTTP_TIMEOUT=10

# 单次执行总超时（秒）
RUN_TIMEOUT=1800

# 报告保留份数
REPORT_KEEP=20

# 前端默认操作人（可留空）
OPERATOR_DEFAULT=

# 平台日志级别
LOG_LEVEL=info

# —— AI 语义仲裁（审核正确性的大模型兜底）——
# 关闭时（默认）：审核正确性只用关键词算法判定，行为与改造前完全一致
# 开启后：关键词判定"建议不一致"的规则会调用大模型复核；模型判一致则不计差异
# 注意：模型调用失败/超时/响应非法一律判该用例失败，不做降级
AI_JUDGE_ENABLED=false
# OpenAI 兼容接口根地址（含 /v1），如 http://192.168.1.10:8000/v1
LLM_BASE_URL=http://192.168.191.144:11000/glm5/v1
# API Key；内网模型无鉴权时留空
LLM_API_KEY=sk-eCkyKlifhEolWJUz4nng4M7Wlwi16LWXCjNbsDJkILksyJHH
# 模型名，如 qwen-plus / deepseek-chat
LLM_MODEL=glm-5.2
# 单次调用超时（秒）
LLM_TIMEOUT=30
# 仲裁范围：inconsistent（默认，只复核关键词判不一致的）| all（所有建议对都送模型）
AI_JUDGE_SCOPE=inconsistent
# 建议语义比对阈值：两段建议的关键词 Jaccard 重叠率 ≥ 此值判语义一致
# 默认 0.3（30%）；调严可设 0.4，调松可设 0.2；取值范围 (0, 1]
SUGGESTION_OVERLAP_THRESHOLD=0.3

# —— 审核正确性匹配模式（一条规则多处命中的场景）——
# true（默认）：按规则基 ID（ruleId 去掉运行序号后缀 _N）分组，组内按命中原文相似度配对，
#              一对多命中不受后端运行序号漂移影响；false 回退旧的 ruleId 精确匹配
ACC_GROUP_MATCH=true
# 组内配对相似度阈值：命中原文关键词 Jaccard ≥ 此值才配对；不配的分别记 missing/extra
# 留空则沿用 SUGGESTION_OVERLAP_THRESHOLD；取值范围 (0, 1]
ACC_PAIR_THRESHOLD=0.3

# —— 平台登录访问（单账号）——
# 默认开启；访问平台需先登录
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=test123456
# 签名密钥，留空则由密码派生；建议单独设置一个随机串
AUTH_SECRET=
# 会话有效期（秒），默认 8 小时
AUTH_SESSION_TTL=28800
